<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>HOME_PLACEHOLDER</string>
		<key>LOG_LEVEL</key>
		<string>INFO</string>
		<key>ORT_DISABLE_TELEMETRY</key>
		<string>1</string>
		<key>PATH</key>
		<string>HOME_PLACEHOLDER/.config/opencode/supertonic-tts/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>SUPERTONIC_MODEL_DIR</key>
		<string>HOME_PLACEHOLDER/.config/opencode/supertonic-tts/assets/supertonic-3</string>
		<key>SUPERTONIC_ORT_BACKEND</key>
		<string>cpu</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.opencode.supertonic</string>
	<key>ProgramArguments</key>
	<array>
		<string>HOME_PLACEHOLDER/.config/opencode/supertonic-tts/.venv/bin/python</string>
		<string>-m</string>
		<string>uvicorn</string>
		<string>local_voicemode_server:create_app</string>
		<string>--factory</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8766</string>
		<string>--app-dir</string>
		<string>HOME_PLACEHOLDER/.config/opencode/supertonic-tts</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>HOME_PLACEHOLDER/.config/opencode/supertonic.log</string>
	<key>StandardOutPath</key>
	<string>HOME_PLACEHOLDER/.config/opencode/supertonic.log</string>
	<key>WorkingDirectory</key>
	<string>HOME_PLACEHOLDER/.config/opencode/supertonic-tts</string>
</dict>
</plist>
